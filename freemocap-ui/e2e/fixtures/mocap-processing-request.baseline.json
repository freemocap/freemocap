{
  "kind": "mocap",
  "config": {
    "bodyAlignment": {
      "mode": "auto",
      "additional_transform": null
    },
    "cameraMatching": {
      "automatically_match": true,
      "failure_policy": "continue"
    },
    "anchorSegmentName": "pelvis",
    "exportTallCsv": false,
