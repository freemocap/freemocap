    "blenderExePath": null,
    "autoOpenBlendFile": true,
    "startStage": "observations",
    "stopStage": "reconstruction",
    "baseRunId": 0,
    "runSaveMode": "overwrite",
    "pipelineImplementation": "typed_dataflow"
