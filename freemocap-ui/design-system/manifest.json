  "libraries": [],
  "components": [
    {
      "name": "ButtonCard",
      "group": "Actions",
      "summary": "A 100×116 tile with a large icon over a label, for top-level entry choices (welcome / splash)."
    },
    {
      "name": "ButtonSm",
      "group": "Actions",
      "summary": "The workhorse small button: an optional 20px icon, a text-bg label, an optional dropdown chevron, and an optional hover tooltip."
    },
    {
      "name": "Checkbox",
      "group": "Selection",
      "summary": "A label-wrapped custom checkbox: 12px box inside a 20px hit area, with a 6px square \"check\" that scales in."
    },
    {
      "name": "IconButton",
      "group": "Actions",
      "summary": "A 25px square button holding one 20px CSS-background icon, with an optional hover tooltip."
    },
    {
      "name": "SegmentedControl",
      "group": "Selection",
      "summary": "A pill track of mutually exclusive buttons; the active one sinks into color-bg-primary with primary text."
    },
    {
      "name": "SettingsSection",
      "group": "Settings layout",
      "summary": "The settings-layout grammar: a section is a raised card, a row is label | info | control, every control lands in one 224px right-hand column, and a collapsed s…"
    },
    {
      "name": "SidebarNav",
      "group": "Navigation",
      "summary": "Mode tabs for the side panel; each mode owns a hue — Cameras is green, Playback is blue."
    },
    {
      "name": "ToastNotification",
      "group": "Feedback",
      "summary": "A small bottom-centred message card whose status is carried by its border colour alone."
    },
    {
      "name": "ToggleComponent",
      "group": "Selection",
      "summary": "A full-width labelled row with a switch on the right; the whole row is the hit target."
    },
    {
      "name": "Tooltip",
      "group": "Feedback",
      "summary": "A double-shell hover label: an outer color-bg-primary shell (br-2, 2px padding, shadow-elevated-sharp) around an inner pill with a 1.5px color-border-secondary…"
    },
    {
      "name": "UpdateBanner",
      "group": "Feedback",
      "summary": "A full-width status strip for app-update state, plus a 4px progress track."
    }
  ],
